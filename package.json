{
  "name": "multiagent-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多个 claude / codex / opencode 实例在同一个房间里通过 @ 点名协作",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "maroom": "./bin/room.mjs"
  },
  "scripts": {
    "start": "node bin/room.mjs",
    "demo": "node bin/room.mjs --demo",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "verify-deploy": "bash scripts/verify-deploy.sh",
    "test:deploy": "bash scripts/verify-deploy.sh",
    "check:exitcode": "bash scripts/check-exitcode-usage.sh"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "docs/",
    "scripts/",
    "test/",
    "README.md",
    "使用说明.md"
  ]
}
