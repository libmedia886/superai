#!/bin/bash
# 受约束的网络读取器（CR-032）。
#
# 为什么需要它：`--allowedTools "Bash(curl:*)"` 的审批器**只看命令名，不看副作用**——
# 实测同一条 curl 能 `file:///etc/hostname` 读本机文件、能 `-o /tmp/x` 写目录外、
# 能 `-T` 上传外传。也就是说放行 curl 等价于「读本机任意可读文件 + 任意方向网络访问」。
#
# 这个包装器把「能联网取资料」这一件事单独摘出来，并把它限制成：
#   · 只有 http/https（file/ftp/scp 等一律拒）
#   · 只有 GET（上传类参数一律拒：上传 = 数据离开这台机器，不可逆）
#   · -o 必须落在 $PWD 内（realpath 解析后比较，防 ../ 与符号链接）
#   · 强制超时，避免挂死；限制重定向次数
#
# 由 app 生成在**成员 cwd 之外**（<data>/bin/netget），成员即使有 Write 也改不到它。
#
# ★ 绝不走 PATH 找 curl（管理方 22:31 复现的提权）：
#   成员能写自己的 cwd，如果在里面放一个假的 `curl`，而本脚本用裸 `curl` 调用，
#   那真正执行的就不是 curl —— 协议限制、GET-only、目录内写**全部归零**。
#   实测：PATH=$PWD:$PATH netget https://… → 执行了成员放置的脚本，把 /etc/hostname
#   写到了 /tmp。所以：
#     · curl 用**绝对路径**（生成时解析好写死，不在运行时查）
#     · PATH 重设为固定系统路径，不继承成员的 PATH
#     · 用绝对路径调 coreutils，避免同样的问题
#
# 退出码（调用方与测试据此判断）：
#   0 成功
#   2 参数/协议不允许
#   3 拒绝写到工作目录之外
#   4 下载失败（curl 非 0）

set -u
set -o pipefail

# 不继承调用方的 PATH：里面可能含着成员的 cwd
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# curl 的绝对路径在生成时由 app 写死（见 sessions.js）。
# 未替换时（例如仓库里这份模板被直接调用）回退到**固定绝对候选**——
# 依然是绝对路径，**绝不查 PATH**。
CURL_BIN='@CURL_BIN@'
# 模板未被替换时（仓库里这份原件被直接调用）：回退到固定绝对候选，绝不查 PATH
case "$CURL_BIN" in
  *'@'*) 
    CURL_BIN=''
    for cand in /usr/bin/curl /bin/curl /usr/local/bin/curl; do
      if [ -x "$cand" ]; then CURL_BIN="$cand"; break; fi
    done ;;
esac
if [ -z "$CURL_BIN" ] || [ ! -x "$CURL_BIN" ]; then
  echo "netget: 找不到可用的 curl（拒绝执行；不会去 PATH 里找）" >&2
  exit 5
fi
# 再用绝对路径的 realpath 复核一次（防止 app 生成时读到的是被篡改的路径）
REAL_CURL=$(/usr/bin/realpath -m -- "$CURL_BIN" 2>/dev/null || echo "$CURL_BIN")
case "$REAL_CURL" in
  /usr/bin/*|/bin/*|/usr/local/bin/*) ;;
  *) echo "netget: curl 路径不可信（$REAL_CURL），拒绝执行" >&2; exit 5 ;;
esac
CURL_BIN="$REAL_CURL"

MAX_TIME="${NETGET_MAX_TIME:-25}"     # 单次最长秒数
MAX_REDIRECTS="${NETGET_MAX_REDIRECTS:-3}"
MAX_BYTES="${NETGET_MAX_BYTES:-5242880}"   # 5 MB，查资料够用

out=""
url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)
      [ $# -ge 2 ] || { echo "netget: -o 缺少路径" >&2; exit 2; }
      out="$2"; shift 2 ;;
    -o=*|--output=*)
      out="${1#*=}"; shift ;;
    http://*|https://*)
      url="$1"; shift ;;
    *://*)
      # 明确拒绝所有其他协议；这条是本工具存在的核心理由
      echo "netget: 协议不允许「$1」（只支持 http/https）" >&2; exit 2 ;;
    -T|--upload-file|-d|--data|--data-raw|--data-binary|--data-urlencode|-F|--form|-X|--request)
      # 上传类参数：数据离开这台机器不可逆
      echo "netget: 参数不允许「$1」（本工具只做 GET，不支持上传/自定义方法）" >&2; exit 2 ;;
    -s|--silent|-S|--show-error|-L|--location|-sS|-sSL|--compressed|-I|--head)
      # 允许少量无害的 curl 兼容参数，但重定向与超时由本脚本强制
      case "$1" in
        -I|--head) HEAD=1 ;;
      esac
      shift ;;
    --)
      shift ;;
    -*)
      echo "netget: 参数不允许「$1」" >&2; exit 2 ;;
    *)
      # 裸参数：只接受绝对 http(s) URL；其余当错误（防把路径当 URL）
      echo "netget: 无法识别「$1」，用法：netget [-o 输出路径] <http(s) URL>" >&2; exit 2 ;;
  esac
done

[ -z "$url" ] && { echo "netget: 需要 http/https URL" >&2; exit 2; }

CURL_ARGS=(-sS -L --max-time "$MAX_TIME" --max-redirs "$MAX_REDIRECTS"
           --proto '=http,https' --proto-redir '=http,https'
           --max-filesize "$MAX_BYTES")
[ "${HEAD:-0}" = "1" ] && CURL_ARGS+=(-I)

if [ -n "$out" ]; then
  # realpath -m：允许目标还不存在；解析 .. 与符号链接，防止绕过
  real_out=$(/usr/bin/realpath -m -- "$out") || { echo "netget: 无法解析输出路径" >&2; exit 2; }
  real_cwd=$(/usr/bin/realpath -m -- "$PWD") || { echo "netget: 无法解析工作目录" >&2; exit 2; }

  case "$real_out" in
    "$real_cwd"/*) ;;
    *) echo "netget: 拒绝写到工作目录之外（$real_out 不在 $real_cwd 内）" >&2; exit 3 ;;
  esac

  # 目标父目录不存在时自己建（且必须仍在 cwd 内）。
  # 实测（CR-046 真机一轮）：模型按提示词写 `-o work/page.html`，
  # 而 `work/` 不存在 → curl 报 "(23) client returned ERROR on write"，整轮白烧一次。
  # 那不是模型的错，是我们给了它一个跑不通的示例。
  parent=$(/usr/bin/dirname -- "$real_out")
  case "$parent" in
    "$real_cwd"/*) ;;
    *) echo "netget: 拒绝创建目录「$parent」（不在工作目录内）" >&2; exit 3 ;;
  esac
  /usr/bin/mkdir -p -- "$parent" 2>/dev/null || true

  # 注意用 exec 的是**绝对路径**，不是裸 curl
  # 不要把 stderr 并进 stdout：netget 的 stdout 是下载内容，
  # 混进 curl 的错误行会污染正文。也不用 exec —— 要保留退出码语义。
  "$CURL_BIN" "${CURL_ARGS[@]}" -o "$real_out" "$url"
  exit $?
fi

"$CURL_BIN" "${CURL_ARGS[@]}" "$url"
exit $?
